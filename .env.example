# AltoFox Production & Local Environment Configuration

# Database (Prisma SQLite fallback)
DATABASE_URL="file:./dev.db"

# Secret key for encrypting AI provider API keys at rest (AES-256)
# Generate one using: openssl rand -hex 32
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Canonical site URL for Open Graph, SEO, and absolute redirects
NEXT_PUBLIC_SITE_URL="https://ranklocal.site"

# Supabase Auth, Database & Storage (Required for team collaboration, auth, and cloud projects)
# Note: In Next.js client code, both NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are required.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsIn..."
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsIn..."
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# Optional: Default Server-side AI API Keys (can also be configured via in-app UI Settings)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# DEEPSEEK_API_KEY=""
# OPENROUTER_API_KEY=""

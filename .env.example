# AltoFox Environment Configuration

# Database (SQLite default)
DATABASE_URL="file:./dev.db"

# Secret key for encrypting API keys at rest (AES-256)
# Generate one using: openssl rand -hex 32
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional: Default Server-side API Keys (if you want to pre-configure any provider)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# DEEPSEEK_API_KEY=""
# OPENROUTER_API_KEY=""
